{
  "version": 2,
  "builds": [
    {
      "src": "api/kamus.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "download/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/kamus",
      "dest": "/api/kamus.js"
    },
    {
      "src": "/download/(.*)",
      "dest": "/download/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
